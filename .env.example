# ─── Supabase ────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# ─── Secrets das Edge Functions (configurar via Supabase CLI ou Dashboard) ───
# Estes valores NÃO vão no .env do frontend — ficam nos secrets do Supabase.
# Configure com: supabase secrets set NOME=valor --project-ref SEU_PROJECT_ID
#
# Z-API (WhatsApp): https://z-api.io
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
#
# Resend (email): https://resend.com
# RESEND_API_KEY=
#
# Webhook de pagamentos (Kiwify)
# PAYMENT_WEBHOOK_SECRET=
